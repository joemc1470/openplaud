# openplaud .env for Unraid deployment
#
# Copy this file to /mnt/user/appdata/openplaud/src/.env and fill in
# the secret values. NEVER commit a filled-in copy of this file to git.
#
# Generated values: see deploy/unraid/README.md "Secrets" step.

# === REQUIRED ===

# Better Auth session secret. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# AES-256-GCM key for encrypting Plaud bearer tokens, AI provider keys, S3 creds.
# Generate with: openssl rand -hex 32
# WARNING: losing this key makes all encrypted DB rows unrecoverable.
ENCRYPTION_KEY=

# URL the app is reachable at. For Phase 1 (LAN-only) use the Unraid hostname.
# Default Unraid hostname is "Tower" unless you renamed the box.
# Port 3030 because Mealie already owns :3000 on this Unraid.
# If you change the port mapping in docker-compose.override.yml, change it here too.
APP_URL=http://tower.local:3030

# Postgres connection string. Default matches docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@db:5432/openplaud

# === OPTIONAL (Phase 1: leave commented out) ===

# Storage type — Phase 1 uses local. Switch to 's3' if/when we move blobs off Unraid.
# DEFAULT_STORAGE_TYPE=local

# S3-compatible config — only set if DEFAULT_STORAGE_TYPE=s3.
# S3_ENDPOINT=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# SMTP — skip; we use Discord pings, not email.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
